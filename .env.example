# Site
NEXT_PUBLIC_SITE_URL=https://fundforfounders.com

# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
# Use a verified domain in production, e.g. FundForFounders <hello@fundforfounders.com>
RESEND_FROM_EMAIL=FundForFounders <onboarding@resend.dev>

# Where registrations & contact forms are delivered
CONTACT_EMAIL=hello@fundforfounders.com
INTERNAL_NOTIFY_EMAIL=team@fundforfounders.com

# Supabase (leads database)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin dashboard (/admin/leads)
ADMIN_SECRET=choose-a-long-random-secret

# Optional social
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com
